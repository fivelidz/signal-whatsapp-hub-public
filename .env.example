# Copy to `.env` and fill in. All values are optional except your accounts.
# The app reads these at launch; nothing is hardcoded.

# --- Signal ---
# Path to the signal-cli launcher (0.14.5+ recommended — needs Java 25).
HUB_SIGNAL_CLI=/path/to/signal-cli-0.14.5/bin/signal-cli
# signal-cli --config dir (account data lives under here).
HUB_SIGNAL_CONFIG=$HOME/.local/share/signal-cli
# Your Signal number in +E.164.
HUB_SIGNAL_ACCOUNT=+15551234567
# JAVA_HOME for signal-cli (point at a Java 25 JDK).
HUB_JAVA_HOME=/usr/lib/jvm/java-25-openjdk

# --- WhatsApp ---
# Path to a whatsmeow-based whatsapp-cli (link/send/receive/status).
HUB_WA_CLI=/path/to/whatsapp-cli
# Directory holding the WhatsApp session (whatsapp.db).
HUB_WA_AUTH=$HOME/.local/share/whatsapp-hub/auth
# Your WhatsApp number in +E.164.
HUB_WA_ACCOUNT=+15551234567

# --- Optional ---
# One-time import of prior history on first launch (idempotent).
# HUB_IMPORT_CSV=/path/to/messages.csv
