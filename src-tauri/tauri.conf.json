{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Signal WhatsApp Hub",
  "version": "0.2.0",
  "identifier": "com.example.signalwhatsapphub",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Signal WhatsApp Hub",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
